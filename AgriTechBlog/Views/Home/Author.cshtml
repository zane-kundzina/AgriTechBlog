@model AgriTechBlog.WebUI.Models.HomeViewModels.AuthorViewModel

@{
    Layout = "_HomeLayout";
    ViewData["HeaderImage"] = $"../../UserFiles/Users/{Model.Author.Id}/HeaderImage.jpg";
    ViewData["HeaderTitle"] = $"{Model.Author.FirstName} {Model.Author.LastName}";
    ViewData["SubHeader"] = Model.Author.SubHeader;
}

<article>
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-md-10 mx-auto">
                @Html.Raw(Model.Author.AboutContent)
            </div>
        </div>
        <div class="row">
            <div class="col-lg-8 col-md-10 mx-auto">
                <form asp-controller="Home" asp-action="Author" class="d-none d-md-inline-block form-inline ml-auto mr-0 mr-md-3 my-2 my-md-0">
                    <div class="input-group">
                        <input name="AuthorId" hidden readonly value="@Model.Author.Id" />
                        <input asp-for="SearchString" type="text" class="form-control" placeholder="Search posts for..." />
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary" type="submit" style="margin-left: 10px;">Search</button>
                        </div>
                    </div>
                </form>

                <!-- Space before posts -->
                <hr style="margin: 30px 0; border-top: 1px solid #ddd;" />

                <div class="row align-content-center">
                    @foreach (var post in Model.Posts)
                    {
                        <div class="col-lg-4 col-md-3 mb-4">
                            <div class="card border-0 shadow">
                                <img src="~/UserFiles/Posts/@post.Id/HeaderImage.jpg" class="card-img-top">
                                <div class="card-body">
                                    <div class="row text-center" style="margin: 0px auto 10px 0px;">
                                        <h6 class="card-title text-center w-100"><a asp-controller="Post" asp-action="Index" asp-route-id="@post.Id">@post.Title</a></h6>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div paged-list="@Model.Posts">
                    <!-- Your pagination UI (e.g., page links) -->
                    @Html.PagedListPager(Model.Posts, page => Url.Action("Index", new { page, searchString = Model.SearchString }))
                </div>
            </div>
        </div>
    </div>
</article>