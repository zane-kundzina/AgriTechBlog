@model AgriTechBlog.WebUI.Models.AdminViewModels.IndexViewModel
<div class="container-fluid">
    <h1 class="mt-4">Dashboard</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Your Posts</li>
    </ol>
    <div class="row">
        @foreach (var post in Model.Posts) 
        {
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-0 shadow">
                    <img src="~/UserFiles/Posts/@post.Id/HeaderImage.jpg" class="card-img-top">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fas @(post.Published ? "fa-eye" : "fa-eye-slash")"
                               style="color: @(post.Published ? "deepskyblue" : "orangered"); margin-right: 8px;"></i>
                            <h5 class="card-title mb-0">@post.Title</h5>
                        </div>

                        <div class="d-flex align-items-center text-muted mb-2">
                            <i class="fas fa-calendar-alt" style="color: gray;"></i>&nbsp;
                            <span>Last updated on: @post.UpdatedDate.ToString()</span>
                        </div>
                        <div class="d-flex align-items-center text-muted">
                            <i class="fas fa-comment" style="color: gray;"></i>&nbsp;
                            <span>@post.Comments.Count() comments</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="row">
                            <div class="col">
                                <a asp-controller="Post" asp-action="Index" asp-route-id="@post.Id" class="btn btn-primary">
                                    <i class="fa fa-arrow-circle-right"></i> View
                                </a>
                            </div>
                            <div class="col">
                                <a asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-secondary float-right">
                                    <i class=" fa fa-edit"></i> Edit
                                </a>
                            </div>
                            <div class="col">
                                <form asp-controller="Post" asp-action="ToggleVisibility" asp-route-id="@post.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(post.Published ? "btn-warning" : "btn-secondary")">
                                        <i class="fa @(post.Published ? "fa-eye-slash" : "fa-eye")"></i> @(post.Published ? "Hide" : "Unhide")
                                    </button>
                                </form>
                            </div>
                            <div class="col">
                                <form asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this post?');">
                                    <button type="submit" class="btn btn-danger float-right">
                                        <i class="fa fa-trash"></i> Delete
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>